#!/usr/bin/env bash
set -Eeuo pipefail

ETC_DIR="${SMARTUNLOCK_ETC_DIR:-/etc/smartdns-unlock}"
APP_DIR="${SMARTUNLOCK_APP_DIR:-/opt/smartdns-unlock}"
SMARTDNS_CONF="${SMARTUNLOCK_SMARTDNS_CONF:-/etc/smartdns/smartdns.conf}"
SERVICE_NAME="${SMARTUNLOCK_SERVICE_NAME:-smartdns-unlock}"
UPSTREAM_FILE="$ETC_DIR/upstreams.tsv"
ENABLED_FILE="$ETC_DIR/enabled.tsv"
REGISTRY_FILE="$APP_DIR/config/platforms.json"
RULE_DIR="$ETC_DIR/rules"
GENERATED_DIR="$ETC_DIR/generated"

die() { printf '错误：%s\n' "$*" >&2; exit 1; }
info() { printf '[smartunlock] %s\n' "$*"; }
need_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "请使用 sudo 运行"; }
valid_id() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]; }
platform_exists() { jq -e --arg id "$1" '.platforms[] | select(.id == $id)' "$REGISTRY_FILE" >/dev/null; }
group_exists() { awk -F'|' -v group="$1" '$1 == group {found=1} END {exit !found}' "$UPSTREAM_FILE"; }

lock_and_run() {
  exec 9>"$ETC_DIR/.lock"
  flock -w 30 9 || die "另一个任务正在运行"
  "$@"
}

render() {
  need_root
  mkdir -p "$GENERATED_DIR" "$RULE_DIR"
  local stage backup platform group set_name file proto endpoint options priority directive
  stage="$(mktemp -d "$ETC_DIR/.generated.XXXXXX")"

  {
    printf '# Generated by smartunlock. Do not edit.\n'
    while IFS='|' read -r group priority proto endpoint options; do
      [[ -n "${group:-}" ]] || continue
      valid_id "$group" || die "非法上游组名称：$group"
      case "$proto" in
        udp) directive=server ;;
        tcp) directive=server-tcp ;;
        dot) directive=server-tls ;;
        doh) directive=server-https ;;
        doq) directive=server-quic ;;
        doh3) directive=server-h3 ;;
        *) die "上游协议不支持：$proto" ;;
      esac
      printf '%s %s -group unlock_%s -exclude-default-group' "$directive" "$endpoint" "$group"
      [[ "$priority" == "backup" ]] && printf ' -fallback'
      [[ -n "${options:-}" ]] && printf ' %s' "$options"
      printf '\n'
    done < "$UPSTREAM_FILE"
  } > "$stage/upstreams.conf"

  {
    printf '# Generated by smartunlock. Do not edit.\n'
    while IFS='|' read -r platform group; do
      [[ -n "${platform:-}" ]] || continue
      platform_exists "$platform" || die "未知平台：$platform"
      group_exists "$group" || die "平台 $platform 指定的上游组不存在：$group"
      file="$RULE_DIR/$platform.txt"
      [[ -s "$file" ]] || die "平台 $platform 的规则文件不存在或为空"
      set_name="su_${platform//-/_}"
      printf 'domain-set -name %s -file %s\n' "$set_name" "$file"
      printf 'domain-rules /domain-set:%s/ -nameserver unlock_%s -speed-check-mode none -response-mode fastest-response\n' "$set_name" "$group"
    done < "$ENABLED_FILE"
  } > "$stage/platforms.conf"

  backup="$ETC_DIR/backups/$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$backup"
  cp -a "$GENERATED_DIR/." "$backup/" 2>/dev/null || true
  install -m 0644 "$stage/upstreams.conf" "$GENERATED_DIR/upstreams.conf"
  install -m 0644 "$stage/platforms.conf" "$GENERATED_DIR/platforms.conf"

  if command -v systemctl >/dev/null && systemctl restart "$SERVICE_NAME"; then
    rm -rf -- "$stage"
    info "SmartDNS 配置已生效"
  else
    cp -a "$backup/." "$GENERATED_DIR/" 2>/dev/null || true
    systemctl restart "$SERVICE_NAME" 2>/dev/null || true
    rm -rf -- "$stage"
    die "SmartDNS 启动失败，已回滚；请执行 journalctl -u $SERVICE_NAME -n 80"
  fi
}

cmd_list() {
  local enabled platform_id name category group state
  printf '%-20s %-24s %-12s %-10s %s\n' '平台ID' '名称' '分类' '状态' '上游组'
  jq -r '.platforms[] | [.id,.name,.category] | @tsv' "$REGISTRY_FILE" |
  while IFS=$'\t' read -r platform_id name category; do
    group="$(awk -F'|' -v id="$platform_id" '$1 == id {print $2; exit}' "$ENABLED_FILE")"
    if [[ -n "$group" ]]; then state='开启'; else state='关闭'; group='-'; fi
    printf '%-20s %-24s %-12s %-10s %s\n' "$platform_id" "$name" "$category" "$state" "$group"
  done
}

cmd_on() {
  need_root
  local target="${1:-}" group="${2:-default}" tmp id
  [[ -n "$target" ]] || die "用法：smartunlock on <平台ID|streaming|ai|all> [上游组]"
  group_exists "$group" || die "上游组不存在：$group"
  tmp="$(mktemp "$ETC_DIR/.enabled.XXXXXX")"
  cp "$ENABLED_FILE" "$tmp"
  if [[ "$target" =~ ^(streaming|ai|all)$ ]]; then
    if [[ "$target" == all ]]; then jq_filter='.platforms[].id'; else jq_filter=".platforms[] | select(.category == \"$target\") | .id"; fi
    while read -r id; do
      awk -F'|' -v id="$id" '$1 != id' "$tmp" > "$tmp.next"
      printf '%s|%s\n' "$id" "$group" >> "$tmp.next"
      mv "$tmp.next" "$tmp"
    done < <(jq -r "$jq_filter" "$REGISTRY_FILE")
  else
    platform_exists "$target" || die "未知平台：$target"
    awk -F'|' -v id="$target" '$1 != id' "$tmp" > "$tmp.next"
    printf '%s|%s\n' "$target" "$group" >> "$tmp.next"
    mv "$tmp.next" "$tmp"
  fi
  sort -u "$tmp" -o "$tmp"
  install -m 0600 "$tmp" "$ENABLED_FILE"
  rm -f "$tmp"
  render
}

cmd_off() {
  need_root
  local target="${1:-}" tmp id
  [[ -n "$target" ]] || die "用法：smartunlock off <平台ID|streaming|ai|all>"
  tmp="$(mktemp "$ETC_DIR/.enabled.XXXXXX")"
  if [[ "$target" == all ]]; then
    : > "$tmp"
  elif [[ "$target" =~ ^(streaming|ai)$ ]]; then
    cp "$ENABLED_FILE" "$tmp"
    while read -r id; do
      awk -F'|' -v id="$id" '$1 != id' "$tmp" > "$tmp.next"
      mv "$tmp.next" "$tmp"
    done < <(jq -r ".platforms[] | select(.category == \"$target\") | .id" "$REGISTRY_FILE")
  else
    platform_exists "$target" || die "未知平台：$target"
    awk -F'|' -v id="$target" '$1 != id' "$ENABLED_FILE" > "$tmp"
  fi
  install -m 0600 "$tmp" "$ENABLED_FILE"
  rm -f "$tmp"
  render
}

cmd_upstream_add() {
  need_root
  local group="${1:-}" priority="${2:-}" proto="${3:-}" endpoint="${4:-}" options="${5:-}" tmp
  [[ -n "$endpoint" ]] || die "用法：smartunlock upstream-add <组> <primary|backup> <udp|tcp|dot|doh|doq|doh3> <地址> [SmartDNS附加参数]"
  valid_id "$group" || die "非法上游组名称"
  [[ "$priority" =~ ^(primary|backup)$ ]] || die "优先级只能是 primary 或 backup"
  [[ "$proto" =~ ^(udp|tcp|dot|doh|doq|doh3)$ ]] || die "协议不支持：$proto"
  [[ "$endpoint" != *'|'* && "$options" != *'|'* ]] || die "地址或参数不能包含 |"
  tmp="$(mktemp "$ETC_DIR/.upstream.XXXXXX")"
  awk -F'|' -v g="$group" -v p="$priority" '!( $1 == g && $2 == p )' "$UPSTREAM_FILE" > "$tmp"
  printf '%s|%s|%s|%s|%s\n' "$group" "$priority" "$proto" "$endpoint" "$options" >> "$tmp"
  install -m 0600 "$tmp" "$UPSTREAM_FILE"
  rm -f "$tmp"
  render
}

cmd_upstream_list() {
  printf '%-16s %-9s %-7s %s\n' '上游组' '角色' '协议' '地址'
  awk -F'|' '{printf "%-16s %-9s %-7s %s\n",$1,$2,$3,$4}' "$UPSTREAM_FILE"
}

cmd_update() {
  need_root
  local env_file="$ETC_DIR/github.env" repository token archive tmp extracted curl_config
  [[ -r "$env_file" ]] || die "缺少 $env_file"
  # shellcheck disable=SC1090
  source "$env_file"
  repository="${SMARTUNLOCK_REPOSITORY:-}"
  token="${GITHUB_TOKEN:-}"
  [[ "$repository" == */* ]] || die "GitHub 仓库未配置"
  tmp="$(mktemp -d "$ETC_DIR/.update.XXXXXX")"
  archive="$tmp/repo.tar.gz"
  curl_config="$tmp/curl.conf"
  if [[ -n "$token" ]]; then
    printf 'header = "Authorization: Bearer %s"\n' "$token" > "$curl_config"
    chmod 0600 "$curl_config"
    curl -fsSL --retry 3 --config "$curl_config" \
      -H 'Accept: application/vnd.github+json' \
      "https://api.github.com/repos/$repository/tarball/main" -o "$archive"
  else
    curl -fsSL --retry 3 \
      "https://github.com/$repository/archive/refs/heads/main.tar.gz" -o "$archive"
  fi
  mkdir "$tmp/repo"
  tar -xzf "$archive" --strip-components=1 -C "$tmp/repo"
  extracted="$tmp/repo/rules/generated"
  [[ -s "$extracted/manifest.json" ]] || die "下载包缺少规则清单"
  jq -e '.platforms | type == "object"' "$extracted/manifest.json" >/dev/null || die "规则清单损坏"
  find "$extracted" -maxdepth 1 -name '*.txt' -type f -size +0c | grep -q . || die "下载包没有有效规则"

  mkdir -p "$ETC_DIR/rules.previous"
  cp -a "$RULE_DIR/." "$ETC_DIR/rules.previous/" 2>/dev/null || true
  cp -a "$extracted/." "$RULE_DIR/"
  install -m 0644 "$tmp/repo/config/platforms.json" "$APP_DIR/config/platforms.json"
  if ! (render); then
    cp -a "$ETC_DIR/rules.previous/." "$RULE_DIR/" 2>/dev/null || true
    (render) || true
    rm -rf -- "$tmp"
    die "更新规则后应用失败，已恢复旧规则"
  fi
  rm -rf -- "$tmp"
  info "规则更新完成"
}

cmd_status() {
  systemctl --no-pager --full status "$SERVICE_NAME" 2>/dev/null | sed -n '1,8p' || true
  printf '\n已启用平台：%s\n' "$(grep -c '^[^#[:space:]]' "$ENABLED_FILE" || true)"
  printf '规则更新时间：'
  stat -c '%y' "$RULE_DIR/manifest.json" 2>/dev/null || printf '未知\n'
}

usage() {
  cat <<'EOF'
SmartDNS Unlock 控制命令

  smartunlock list
  smartunlock on netflix [上游组]
  smartunlock on streaming|ai|all [上游组]
  smartunlock off netflix|streaming|ai|all
  smartunlock upstream-add default primary doh https://dns.example/dns-query
  smartunlock upstream-add default backup dot tls://dns-backup.example:853
  smartunlock upstream-list
  smartunlock apply
  smartunlock update
  smartunlock status
EOF
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
    list) cmd_list "$@" ;;
    on) lock_and_run cmd_on "$@" ;;
    off) lock_and_run cmd_off "$@" ;;
    upstream-add) lock_and_run cmd_upstream_add "$@" ;;
    upstream-list) cmd_upstream_list "$@" ;;
    apply) lock_and_run render ;;
    update) lock_and_run cmd_update ;;
    status) cmd_status ;;
    help|-h|--help) usage ;;
    *) usage; die "未知命令：$command" ;;
  esac
}

main "$@"
